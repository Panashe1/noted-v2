<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Noted" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <%= yield :head %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-sp-black text-white antialiased overflow-hidden h-screen flex"
        data-controller="modal">

    <%# ══════════════════════════════════════════════════ %>
    <%# ── Desktop sidebar (hidden on mobile) ── %>
    <%# ══════════════════════════════════════════════════ %>
    <aside class="hidden lg:flex w-60 shrink-0 flex-col gap-2 py-2 overflow-y-auto bg-sp-black">

      <div class="px-6 pt-4 pb-1">
        <%= link_to root_path do %>
          <span class="wordmark text-white font-bold text-2xl tracking-tight">noted</span>
        <% end %>
      </div>

      <nav class="bg-sp-base rounded-lg mx-2 px-3 py-3 flex flex-col gap-1">
        <% profile_path = user_signed_in? ? user_path(current_user.username) : root_path %>
        <%= nav_link "Profile",     profile_path,         '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>' %>
        <%= nav_link "Find People", user_search_path,    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27C15.53 12.59 16 11.11 16 9.5 16 5.42 12.58 2 8.5 2S1 5.42 1 9.5 4.42 17 8.5 17c1.61 0 3.09-.47 4.23-1.57l.27.28v.79l5 4.99L19.49 19l-4.99-5zm-7 0C5.01 14 3 11.99 3 9.5S5.01 5 7.5 5 12 7.01 12 9.5 9.99 14 7.5 14zm3.5-5H9v2H7v-2H5V7h2V5h2v2h2v2z"/></svg>' %>
        <%= nav_link "Discover",    recommendations_path, '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>' %>
        <%= nav_link "Albums",      albums_path,          '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/></svg>' %>
        <%= nav_link "Tracks",      tracks_path,          '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>' %>
      </nav>

      <% if user_signed_in? %>
        <div class="bg-sp-base rounded-lg mx-2 px-3 py-3">
          <button data-action="click->modal#open"
                  class="w-full flex items-center gap-3 px-3 py-2 rounded-md text-sm font-semibold text-zinc-400 hover:text-white transition-colors group">
            <span class="w-6 h-6 shrink-0 rounded-sm bg-zinc-700 group-hover:bg-sp-green flex items-center justify-center transition-colors">
              <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            </span>
            Log an album
          </button>
        </div>
      <% end %>

      <div class="flex-1"></div>

      <%# ── Language switcher ── %>
      <div class="mx-2 mb-1 flex items-center gap-1 px-2">
        <% I18n.available_locales.each do |loc| %>
          <%= link_to locale_path(loc),
                class: "px-2 py-1 rounded-md text-xs font-semibold transition-colors #{I18n.locale == loc ? 'bg-sp-raised text-white' : 'text-zinc-500 hover:text-white'}" do %>
            <%= loc.to_s.upcase %>
          <% end %>
        <% end %>
      </div>

      <% if user_signed_in? %>
        <div class="mx-2 bg-sp-base rounded-lg px-3 py-3">
          <div class="flex items-center gap-3">
            <% if current_user.avatar.attached? %>
              <%= image_tag url_for(current_user.avatar),
                    alt: current_user.username,
                    class: "w-9 h-9 rounded-full object-cover shrink-0 ring-1 ring-white/15" %>
            <% else %>
              <div class="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-600 to-blue-700 flex items-center justify-center text-sm font-bold shrink-0 select-none">
                <%= current_user.username[0].upcase %>
              </div>
            <% end %>

            <div class="flex-1 min-w-0">
              <%= link_to user_path(current_user.username), class: "hover:underline truncate block leading-tight" do %>
                <% if current_user.name.present? %>
                  <span class="text-sm font-semibold text-white block truncate"><%= current_user.name %></span>
                  <span class="text-xs text-zinc-500 block truncate">@<%= current_user.username %></span>
                <% else %>
                  <span class="text-sm font-semibold text-white block truncate"><%= current_user.username %></span>
                <% end %>
              <% end %>
            </div>

            <%= link_to destroy_user_session_path, data: { turbo_method: :delete },
                  title: "Sign out", class: "text-zinc-600 hover:text-white shrink-0 transition-colors" do %>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
              </svg>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="mx-2 bg-sp-base rounded-lg px-3 py-4 space-y-2">
          <%= link_to "Sign up", new_user_registration_path, class: "block w-full text-center bg-white text-black text-sm font-bold py-2 rounded-full hover:scale-105 transition-transform" %>
          <%= link_to "Log in",  new_user_session_path,      class: "block w-full text-center text-zinc-400 hover:text-white text-sm font-semibold py-2 transition-colors" %>
        </div>
      <% end %>

    </aside>

    <%# ══════════════════════════════════════════════════ %>
    <%# ── Main content ── %>
    <%# ══════════════════════════════════════════════════ %>
    <div class="flex-1 overflow-y-auto bg-sp-base lg:rounded-tl-lg pb-20 lg:pb-0" id="main-content">

      <% if notice.present? %>
        <div class="flash-message fixed top-4 right-4 z-40 bg-sp-green text-black text-sm font-semibold px-4 py-3 rounded-lg shadow-lg flex items-center gap-2 pointer-events-none">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="flash-message fixed top-4 right-4 z-40 bg-red-500 text-white text-sm font-semibold px-4 py-3 rounded-lg shadow-lg pointer-events-none">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <%# ══════════════════════════════════════════════════ %>
    <%# ── Mobile bottom nav (hidden on desktop) ── %>
    <%# ══════════════════════════════════════════════════ %>
    <nav class="lg:hidden fixed bottom-0 inset-x-0 z-30 bg-sp-black border-t border-white/10 flex items-stretch">

      <% mobile_active = ->(path) { current_page?(path) ? "text-white" : "text-zinc-500" } %>

      <%# Profile %>
      <% mp = user_signed_in? ? user_path(current_user.username) : new_user_session_path %>
      <%= link_to mp, class: "flex-1 flex flex-col items-center justify-center py-2 gap-0.5 transition-colors #{mobile_active.call(mp)} hover:text-white" do %>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
        <span class="text-[9px] font-semibold">Profile</span>
      <% end %>

      <%# Albums %>
      <%= link_to albums_path, class: "flex-1 flex flex-col items-center justify-center py-2 gap-0.5 transition-colors #{mobile_active.call(albums_path)} hover:text-white" do %>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/></svg>
        <span class="text-[9px] font-semibold">Albums</span>
      <% end %>

      <%# Log button — centre FAB (signed-in) or empty slot (signed-out) %>
      <div class="flex-1 flex items-center justify-center py-1">
        <% if user_signed_in? %>
          <button data-action="click->modal#open"
                  class="w-11 h-11 rounded-full bg-sp-green flex items-center justify-center shadow-lg hover:bg-sp-green2 active:scale-95 transition-all">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
          </button>
        <% end %>
      </div>

      <%# Tracks %>
      <%= link_to tracks_path, class: "flex-1 flex flex-col items-center justify-center py-2 gap-0.5 transition-colors #{mobile_active.call(tracks_path)} hover:text-white" do %>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
        <span class="text-[9px] font-semibold">Tracks</span>
      <% end %>

      <%# Discover %>
      <%= link_to recommendations_path, class: "flex-1 flex flex-col items-center justify-center py-2 gap-0.5 transition-colors #{mobile_active.call(recommendations_path)} hover:text-white" do %>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        <span class="text-[9px] font-semibold">Discover</span>
      <% end %>

    </nav>

    <%# ══════════════════════════════════════════════════ %>
    <%# ── Log Album Modal ── %>
    <%# ══════════════════════════════════════════════════ %>
    <% if user_signed_in? %>
      <div data-modal-target="panel"
           data-controller="log-flow"
           class="hidden fixed inset-0 z-50 items-end lg:items-center justify-center"
           data-action="click->modal#closeBtn">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>

        <%# Bottom sheet on mobile, centred card on desktop %>
        <div class="relative bg-sp-raised rounded-t-2xl lg:rounded-2xl w-full lg:max-w-lg lg:mx-4 shadow-2xl max-h-[92vh] overflow-y-auto"
             data-action="click->modal#stopPropagation">

          <%# Drag handle (mobile hint) %>
          <div class="lg:hidden mx-auto mt-3 mb-1 w-10 h-1 rounded-full bg-white/20"></div>

          <%# ── Header ── %>
          <div class="flex justify-between items-center px-5 lg:px-7 pt-4 lg:pt-6 pb-4">
            <div class="flex items-center gap-2">
              <button type="button"
                      data-action="click->log-flow#goBack"
                      data-log-flow-target="backBtn"
                      class="hidden w-7 h-7 flex items-center justify-center rounded-full text-zinc-400 hover:text-white hover:bg-white/10 transition-colors mr-1">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
              </button>
              <h2 class="text-xl font-bold" data-log-flow-target="modalTitle">Log an Album</h2>
            </div>
            <button data-action="click->modal#closeBtn"
                    class="w-8 h-8 flex items-center justify-center rounded-full text-zinc-400 hover:text-white hover:bg-white/10 transition-colors text-lg">
              ✕
            </button>
          </div>

          <%# ══ STEP 1: Search ══ %>
          <div data-log-flow-target="step1" class="px-5 lg:px-7 pb-6 lg:pb-7">
            <input type="text"
                   placeholder="Search for an album…"
                   autocomplete="off"
                   data-log-flow-target="searchInput"
                   data-action="input->log-flow#onSearchInput"
                   class="w-full bg-sp-input rounded-md px-4 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-white/30 mb-3" />

            <div data-log-flow-target="searchResults" class="space-y-0.5 max-h-56 lg:max-h-72 overflow-y-auto"></div>

            <div class="mt-4 border-t border-white/10 pt-4">
              <p class="text-xs text-zinc-500 text-center mb-3">Can't find it? Add manually:</p>
              <button type="button"
                      data-action="click->log-flow#showManual"
                      class="w-full text-center text-xs text-zinc-400 hover:text-white transition-colors underline underline-offset-2">
                Enter details by hand
              </button>
            </div>
          </div>

          <%# ══ STEP 2: Preview + log form ══ %>
          <div data-log-flow-target="step2" class="hidden px-5 lg:px-7 pb-6 lg:pb-7">
            <div data-log-flow-target="previewArea"></div>

            <%= form_with url: listen_logs_path, method: :post, data: { "log-flow-target": "logForm" } do %>
              <input type="hidden" name="album[title]"           data-log-flow-target="formTitle" />
              <input type="hidden" name="album[artist]"          data-log-flow-target="formArtist" />
              <input type="hidden" name="album[release_year]"    data-log-flow-target="formYear" />
              <input type="hidden" name="album[genre]"           data-log-flow-target="formGenre" />
              <input type="hidden" name="album[itunes_id]"       data-log-flow-target="formItunesId" />
              <input type="hidden" name="album[cover_image_url]" data-log-flow-target="formCoverUrl" />
              <input type="hidden" name="album[apple_music_url]" data-log-flow-target="formAppleUrl" />

              <div class="flex items-center gap-3 mb-4">
                <div class="flex-1">
                  <label class="text-xs uppercase tracking-widest text-zinc-500 mb-1 block">Date listened</label>
                  <input name="listen_log[listened_on]" type="date" required
                         max="<%= Date.today %>"
                         class="w-full bg-sp-input rounded-md px-4 py-2.5 text-sm text-zinc-300 focus:outline-none focus:ring-1 focus:ring-white/30" />
                </div>
                <label class="flex items-center gap-2 text-sm text-zinc-400 cursor-pointer mt-4">
                  <input type="checkbox" name="listen_log[is_relisten]" value="1" class="accent-sp-green" />
                  Relisten?
                </label>
              </div>

              <div class="mb-4">
                <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">Rating</p>
                <div class="flex gap-1 flex-wrap">
                  <% (1..10).each do |i| %>
                    <label class="rating-option cursor-pointer">
                      <input type="radio" name="listen_log[rating]" value="<%= i %>" class="sr-only" />
                      <span class="flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold text-zinc-400 hover:bg-white/10 transition-colors select-none"><%= i %></span>
                    </label>
                  <% end %>
                </div>
              </div>

              <textarea name="listen_log[review]" placeholder="Your thoughts… (optional)" rows="3"
                        class="w-full bg-sp-input rounded-md px-4 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-white/30 resize-none mb-5"></textarea>

              <button type="submit"
                      class="w-full bg-sp-green text-black font-bold py-3 rounded-full hover:bg-sp-green2 hover:scale-105 transition-all">
                Log it
              </button>
            <% end %>
          </div>

        </div>
      </div>
    <% end %>

  </body>
</html>
