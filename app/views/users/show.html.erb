<% content_for :title, "@#{@user.username} — Noted" %>

<%# ── Follows modal — controlled by follows-modal Stimulus controller ── %>
<div data-controller="follows-modal">

  <div data-follows-modal-target="panel"
       class="hidden fixed inset-0 z-50 items-center justify-center"
       data-action="click->follows-modal#closeBtn">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>

    <div class="relative bg-sp-raised rounded-2xl w-full max-w-md mx-4 shadow-2xl flex flex-col max-h-[80vh]"
         data-action="click->follows-modal#stopPropagation">

      <%# Modal header %>
      <div class="flex items-center justify-between px-6 pt-5 pb-4 border-b border-white/10 shrink-0">
        <h3 class="text-lg font-bold text-white" data-follows-modal-target="title">Following</h3>
        <button data-action="click->follows-modal#closeBtn"
                class="w-8 h-8 flex items-center justify-center rounded-full text-zinc-400 hover:text-white hover:bg-white/10 transition-colors">
          ✕
        </button>
      </div>

      <%# Scrollable list area %>
      <div data-follows-modal-target="content" class="overflow-y-auto flex-1 px-1"></div>
    </div>
  </div>

<%# ── Profile hero ── %>
<div class="min-h-[14rem] sm:h-64 bg-gradient-to-b from-indigo-950 via-zinc-950/60 to-zinc-950 px-4 sm:px-8 pt-6 sm:pt-8 flex items-end pb-5 sm:pb-6">
  <div class="flex items-end gap-4 sm:gap-6 w-full">

    <%# Avatar ── real photo or gradient-initials fallback %>
    <% if @user.avatar.attached? %>
      <%= image_tag url_for(@user.avatar),
            alt: @user.username,
            class: "w-20 h-20 sm:w-28 sm:h-28 rounded-full object-cover shadow-2xl ring-2 ring-white/15 shrink-0" %>
    <% else %>
      <div class="w-20 h-20 sm:w-28 sm:h-28 rounded-full bg-gradient-to-br from-indigo-600 to-blue-700 flex items-center justify-center text-3xl sm:text-4xl font-black shadow-2xl shrink-0 select-none ring-2 ring-white/15">
        <%= @user.username[0].upcase %>
      </div>
    <% end %>

    <div class="flex-1 pb-1 min-w-0">
      <p class="text-xs uppercase tracking-widest text-zinc-400 mb-1">Profile</p>

      <%# Show display name as headline when set, username as subtitle %>
      <% if @user.name.present? %>
        <h1 class="text-xl sm:text-3xl font-extrabold text-white leading-tight"><%= @user.name %></h1>
        <p class="text-zinc-400 text-sm mt-0.5">@<%= @user.username %></p>
      <% else %>
        <h1 class="text-xl sm:text-3xl font-extrabold text-white">@<%= @user.username %></h1>
      <% end %>

      <div class="flex items-center gap-4 mt-2 text-sm text-zinc-400 flex-wrap">
        <span><strong class="text-white"><%= @user.listen_logs.count %></strong> logs</span>

        <%# Following + Followers are wrapped together so they never split across lines %>
        <span class="flex items-center gap-4">
          <button data-action="click->follows-modal#open"
                  data-url="<%= user_following_path(@user.username) %>"
                  data-title="Following"
                  class="hover:text-white transition-colors cursor-pointer">
            <strong class="text-white"><%= @user.following.count %></strong> following
          </button>

          <button data-action="click->follows-modal#open"
                  data-url="<%= user_followers_path(@user.username) %>"
                  data-title="Followers"
                  class="hover:text-white transition-colors cursor-pointer">
            <strong class="text-white"><%= @user.followers.count %></strong> followers
          </button>
        </span>
      </div>

      <% if @user.bio.present? %>
        <p class="text-zinc-400 text-sm mt-1.5 line-clamp-2"><%= @user.bio %></p>
      <% end %>
    </div>

    <%# Right-side actions ── settings (own profile) or follow button (others) %>
    <div class="shrink-0 self-end pb-1 flex gap-2">
      <% if @own_profile %>
        <%= link_to user_settings_path(@user.username),
              class: "inline-flex items-center gap-2 text-sm font-semibold border border-zinc-700 hover:border-zinc-400 text-zinc-400 hover:text-white rounded-full px-4 py-2 transition-colors" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.22-.07.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
          </svg>
          Settings
        <% end %>

      <% elsif user_signed_in? %>
        <%= turbo_frame_tag "follow_#{@user.id}" do %>
          <% if @is_following %>
            <%= button_to "Following", unfollow_user_path(@user.username), method: :delete,
                  class: "text-sm font-semibold border border-zinc-500 hover:border-white rounded-full px-5 py-2 transition-colors bg-transparent text-white cursor-pointer" %>
          <% else %>
            <%= button_to "Follow", follow_user_path(@user.username),
                  class: "text-sm font-bold bg-white text-black rounded-full px-5 py-2 hover:scale-105 transition-transform cursor-pointer" %>
          <% end %>
        <% end %>
      <% end %>
    </div>

  </div>
</div>

<div class="px-4 sm:px-8 py-5 sm:py-6 space-y-8 sm:space-y-10">

  <%# ── AI taste profile ── %>
  <% taste = @own_profile ? @taste_profile : @user.ai_taste_profile %>
  <% if taste.present? %>
    <div class="bg-sp-surface rounded-xl p-5 border-l-4 border-sp-green" data-controller="clamp">
      <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">Taste profile</p>
      <%# Desktop: always fully expanded. Tablet/mobile: clamped to 3 lines until "Read more" is tapped. %>
      <p data-clamp-target="content" class="text-zinc-300 text-sm leading-relaxed line-clamp-3 lg:line-clamp-none">
        <%= taste %>
      </p>
      <button data-clamp-target="toggle" data-action="click->clamp#toggle"
              class="lg:hidden mt-2 text-xs font-semibold text-sp-green hover:underline focus:outline-none">
        Read more
      </button>
    </div>
  <% end %>

  <%# ════════ Own-profile sections ════════ %>
  <% if @own_profile %>

    <%# Recently logged — grid on mobile, fanned deck on tablet/desktop. %>
    <% if @recent_logs.any? %>
      <section>
        <div class="flex items-center gap-3 mb-4">
          <h2 class="text-xl font-bold">Recently logged</h2>
          <span class="hidden lg:inline text-xs text-zinc-600">hover to browse</span>
        </div>

        <%# ── Mobile (< sm): classic grid ── %>
        <div class="grid grid-cols-2 gap-4 sm:hidden">
          <% @recent_logs.first(10).each do |log| %>
            <%= link_to album_path(log.album), class: "group bg-sp-surface hover:bg-sp-raised rounded-lg p-3 transition-colors cursor-pointer block" do %>
              <div class="aspect-square rounded-md mb-3 shadow-md overflow-hidden relative">
                <% if log.album.cover_url(size: 300).present? %>
                  <img src="<%= log.album.cover_url(size: 300) %>" alt="<%= log.album.title %>"
                       class="w-full h-full object-cover" />
                <% else %>
                  <div class="w-full h-full bg-gradient-to-br <%= album_gradient(log.album) %> to-zinc-900 flex items-center justify-center">
                    <svg class="w-12 h-12 text-white/20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/></svg>
                  </div>
                <% end %>
                <span class="absolute bottom-1.5 left-1.5 text-xs font-bold text-white bg-black/60 px-1.5 py-0.5 rounded z-10"><%= log.rating %>/10</span>
              </div>
              <p class="font-semibold text-xs text-white truncate"><%= log.album.title %></p>
              <p class="text-xs text-zinc-500 truncate mt-0.5"><%= log.album.artist %></p>
            <% end %>
          <% end %>
        </div>

        <%# ── Tablet/Desktop (sm+): fanned deck ──
            Reversed so the most-recent log lands rightmost AND on top of the stack.
            overflow-x-auto lets the fan scroll when it exceeds the viewport; the
            vertical padding gives the hover lift/scale room so it's never clipped. %>
        <div class="hidden sm:flex items-center overflow-x-auto overflow-y-hidden pt-12 pb-6 pr-12 [scrollbar-width:thin]">
          <% @recent_logs.reverse.each_with_index do |log, i| %>
            <%= link_to album_path(log.album),
                  title: "#{log.album.title} — #{log.album.artist}",
                  class: "group relative shrink-0 block w-36 aspect-square rounded-lg overflow-hidden shadow-lg ring-1 ring-white/10 transition-all duration-300 ease-out hover:scale-110 hover:-translate-y-4 hover:z-40 hover:shadow-2xl hover:ring-white/40 #{'-ml-20' unless i.zero?}" do %>

              <%# Cover art or gradient fallback %>
              <% if log.album.cover_url(size: 300).present? %>
                <img src="<%= log.album.cover_url(size: 300) %>" alt="<%= log.album.title %>"
                     class="w-full h-full object-cover" />
              <% else %>
                <div class="w-full h-full bg-gradient-to-br <%= album_gradient(log.album) %> to-zinc-900 flex items-center justify-center">
                  <svg class="w-12 h-12 text-white/20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/></svg>
                </div>
              <% end %>

              <%# Rating badge — always visible, pinned top-left %>
              <span class="absolute top-1.5 left-1.5 text-xs font-bold text-white bg-black/60 px-1.5 py-0.5 rounded z-10"><%= log.rating %>/10</span>

              <%# Title/artist caption — fades in on hover %>
              <div class="absolute inset-x-0 bottom-0 p-2 bg-gradient-to-t from-black/85 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <p class="font-semibold text-xs text-white truncate"><%= log.album.title %></p>
                <p class="text-[11px] text-zinc-300 truncate"><%= log.album.artist %></p>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# Friends activity %>
    <% if @following_logs.any? %>
      <section>
        <h2 class="text-xl font-bold mb-4">Friends activity</h2>
        <div class="space-y-1">
          <% @following_logs.each do |log| %>
            <div class="flex items-center gap-4 px-3 py-2.5 rounded-lg hover:bg-white/5 transition-colors">
              <div class="w-10 h-10 rounded shrink-0 overflow-hidden">
                <% if log.album.cover_url(size: 60).present? %>
                  <img src="<%= log.album.cover_url(size: 60) %>" alt="<%= log.album.title %>"
                       class="w-full h-full object-cover" />
                <% else %>
                  <div class="w-full h-full bg-gradient-to-br <%= album_gradient(log.album) %> to-zinc-900"></div>
                <% end %>
              </div>
              <div class="flex-1 min-w-0">
                <%= link_to album_path(log.album), class: "font-semibold text-sm text-white hover:underline truncate block" do %>
                  <%= log.album.title %>
                <% end %>
                <div class="flex items-center gap-1.5 text-xs text-zinc-500 mt-0.5">
                  <span><%= log.album.artist %></span>
                  <span class="text-zinc-700">·</span>
                  <%= link_to "@#{log.user.username}", user_path(log.user.username), class: "hover:text-white transition-colors" %>
                </div>
              </div>
              <span class="text-sm font-bold <%= rating_color(log.rating) %> shrink-0">
                <%= log.rating %><span class="text-zinc-600 font-normal text-xs">/10</span>
              </span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

  <% end %>
  <%# ════════ End own-profile sections ════════ %>

  <%# ── Logs section with Albums / Tracks tabs ── %>
  <section data-controller="tabs">

    <%# Section header + tab switcher %>
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold"><%= @own_profile ? "All your logs" : "Listening history" %></h2>

      <div class="flex gap-1 bg-sp-surface rounded-lg p-1">
        <button data-tabs-target="tab"
                data-action="click->tabs#switch"
                class="text-xs font-semibold px-3 py-1.5 rounded-md transition-colors text-white bg-sp-card">
          Albums <span class="ml-1 text-zinc-500 font-normal"><%= @logs.size %></span>
        </button>
        <button data-tabs-target="tab"
                data-action="click->tabs#switch"
                class="text-xs font-semibold px-3 py-1.5 rounded-md transition-colors text-zinc-400 bg-transparent">
          Tracks <span class="ml-1 text-zinc-500 font-normal"><%= @track_logs.size %></span>
        </button>
      </div>
    </div>

    <%# ══ Albums panel ══ %>
    <div data-tabs-target="panel">
      <% if @logs.any? %>
        <div class="grid grid-cols-[2rem_1fr_auto] gap-4 px-4 pb-2 border-b border-zinc-800 text-xs uppercase tracking-widest text-zinc-500">
          <span>#</span>
          <span>Album</span>
          <span class="text-right">Rating</span>
        </div>

        <div class="space-y-0.5 mt-1">
          <% @logs.each_with_index do |log, i| %>
            <div class="grid grid-cols-[2rem_1fr_auto] gap-4 items-center px-4 py-3 rounded-lg hover:bg-white/5 transition-colors">
              <span class="text-zinc-500 text-sm tabular-nums"><%= i + 1 %></span>

              <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded shrink-0 overflow-hidden">
                  <% if log.album.cover_url(size: 60).present? %>
                    <img src="<%= log.album.cover_url(size: 60) %>" alt="<%= log.album.title %>"
                         class="w-full h-full object-cover" />
                  <% else %>
                    <div class="w-full h-full bg-gradient-to-br <%= album_gradient(log.album) %> to-zinc-900"></div>
                  <% end %>
                </div>
                <div class="min-w-0">
                  <%= link_to album_path(log.album), class: "font-semibold text-sm text-white hover:underline truncate block" do %>
                    <%= log.album.title %>
                  <% end %>
                  <p class="text-xs text-zinc-400 truncate">
                    <%= log.album.artist %>
                    <% if log.review.present? %>
                      <span class="text-zinc-600 mx-1">·</span>
                      <span class="italic"><%= truncate(log.review, length: 60) %></span>
                    <% end %>
                  </p>
                </div>
              </div>

              <div class="text-right shrink-0">
                <span class="text-sm font-bold <%= rating_color(log.rating) %>"><%= log.rating %><span class="text-zinc-600 font-normal text-xs">/10</span></span>
                <p class="text-xs text-zinc-600 mt-0.5"><%= log.listened_on.strftime("%b %-d") %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-16">
          <p class="text-zinc-500 text-sm">
            <%= @own_profile ? "Nothing logged yet — hit Log an album to get started." : "No album logs yet." %>
          </p>
        </div>
      <% end %>
    </div>

    <%# ══ Tracks panel ══ %>
    <div data-tabs-target="panel" class="hidden">
      <% if @track_logs.any? %>
        <div class="grid grid-cols-[2rem_1fr_auto] gap-4 px-4 pb-2 border-b border-zinc-800 text-xs uppercase tracking-widest text-zinc-500">
          <span>#</span>
          <span>Track</span>
          <span class="text-right">Rating</span>
        </div>

        <div class="space-y-0.5 mt-1">
          <% @track_logs.each_with_index do |tlog, i| %>
            <div class="grid grid-cols-[2rem_1fr_auto] gap-4 items-center px-4 py-3 rounded-lg hover:bg-white/5 transition-colors">
              <span class="text-zinc-500 text-sm tabular-nums"><%= i + 1 %></span>

              <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded shrink-0 overflow-hidden">
                  <% if tlog.track.album.cover_url(size: 60).present? %>
                    <img src="<%= tlog.track.album.cover_url(size: 60) %>"
                         alt="<%= tlog.track.album.title %>"
                         class="w-full h-full object-cover" />
                  <% else %>
                    <div class="w-full h-full bg-gradient-to-br <%= album_gradient(tlog.track.album) %> to-zinc-900"></div>
                  <% end %>
                </div>
                <div class="min-w-0">
                  <%= link_to track_path(tlog.track), class: "font-semibold text-sm text-white hover:underline truncate block" do %>
                    <%= tlog.track.title %>
                  <% end %>
                  <p class="text-xs text-zinc-400 truncate">
                    <%= tlog.track.album.artist %>
                    <span class="text-zinc-600 mx-1">·</span>
                    <%= tlog.track.album.title %>
                  </p>
                </div>
              </div>

              <div class="text-right shrink-0">
                <% if tlog.rating %>
                  <span class="text-sm font-bold <%= rating_color(tlog.rating) %>"><%= tlog.rating %><span class="text-zinc-600 font-normal text-xs">/10</span></span>
                <% else %>
                  <span class="text-sm text-zinc-600">—</span>
                <% end %>
                <p class="text-xs text-zinc-600 mt-0.5"><%= tlog.listened_on.strftime("%b %-d") %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-16">
          <p class="text-zinc-500 text-sm">
            <%= @own_profile ? "No tracks logged yet — head to a track page to log one." : "No track logs yet." %>
          </p>
        </div>
      <% end %>
    </div>

  </section>

</div><%# /px-8 content %>

</div><%# /follows-modal controller %>
