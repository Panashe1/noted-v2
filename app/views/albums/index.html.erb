<% content_for :title, "Albums — Noted" %>

<%# ── Page hero ── %>
<div class="h-44 sm:h-56 bg-gradient-to-b from-blue-900 via-zinc-950/80 to-zinc-950 px-4 sm:px-8 pt-8 sm:pt-10 flex flex-col justify-end pb-5 sm:pb-6">
  <p class="text-xs uppercase tracking-widest text-zinc-400 mb-1">Music</p>
  <h1 class="text-4xl font-extrabold text-white">Albums</h1>
  <p class="text-zinc-400 text-sm mt-1">Apple Music charts · community logs</p>
</div>

<div class="px-3 sm:px-8 py-6 sm:py-8 space-y-10 sm:space-y-12">

  <%# ════════════════════════════════════════ %>
  <%# ── Top Charts section ── %>
  <%# ════════════════════════════════════════ %>
  <% if @top_albums.any? %>
    <section>
      <div class="flex items-baseline justify-between mb-5">
        <div>
          <h2 class="text-xl font-bold text-white">Top Albums</h2>
          <p class="text-xs text-zinc-500 mt-0.5">Apple Music · updated daily</p>
        </div>
        <span class="text-xs uppercase tracking-widest text-zinc-600">Chart</span>
      </div>

      <%# Two-column chart list — rank | art | info | action %>
      <div class="space-y-1">
        <% @top_albums.each do |album| %>
          <%
            # O(1) hash lookup — preloaded in the controller with a single query
            local = @chart_local_albums[album[:itunes_id]]
            dest  = local ? album_path(local) : from_itunes_albums_path(itunes_id: album[:itunes_id])
          %>
          <%= link_to dest, class: "flex items-center gap-4 px-3 py-3 rounded-xl hover:bg-white/5 transition-colors group" do %>

            <%# Rank number %>
            <span class="w-7 text-right text-sm font-bold tabular-nums shrink-0
                         <%= album[:chart_rank] <= 3 ? 'text-sp-subtle' : 'text-zinc-600' %>">
              <%= album[:chart_rank] %>
            </span>

            <%# Album art %>
            <div class="w-12 h-12 rounded-md shrink-0 overflow-hidden shadow-md">
              <% if album[:cover_url].present? %>
                <img src="<%= album[:cover_url].gsub('600x600bb', '120x120bb') %>"
                     alt="<%= album[:title] %>"
                     class="w-full h-full object-cover" />
              <% else %>
                <div class="w-full h-full bg-gradient-to-br from-zinc-700 to-zinc-900"></div>
              <% end %>
            </div>

            <%# Title + artist %>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-sm text-white truncate group-hover:text-sp-subtle transition-colors">
                <%= album[:title] %>
              </p>
              <p class="text-xs text-zinc-400 truncate mt-0.5">
                <%= album[:artist] %>
                <% if album[:genre].present? %>
                  <span class="text-zinc-700 mx-1">·</span>
                  <span class="text-zinc-600"><%= album[:genre] %></span>
                <% end %>
                <% if album[:release_year].present? %>
                  <span class="text-zinc-700 mx-1">·</span>
                  <span class="text-zinc-600"><%= album[:release_year] %></span>
                <% end %>
              </p>
            </div>

            <%# Community log count if already in library %>
            <% if local && local.log_count > 0 %>
              <div class="text-right shrink-0">
                <% if local.average_rating %>
                  <span class="text-xs font-bold <%= rating_color(local.average_rating) %>"><%= local.average_rating %>/10</span>
                <% end %>
                <p class="text-xs text-zinc-600 mt-0.5"><%= local.log_count %> <%= local.log_count == 1 ? "log" : "logs" %></p>
              </div>
            <% end %>

            <%# Arrow %>
            <svg class="w-4 h-4 text-zinc-700 group-hover:text-zinc-400 shrink-0 transition-colors" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
            </svg>

          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# ════════════════════════════════════════ %>
  <%# ── Community albums section ── %>
  <%# ════════════════════════════════════════ %>
  <section>
    <%# The frame wraps the heading, genre pills, grid and pagination so a filter
        click refreshes all of it (and the count) without touching the charts above. %>
    <%= turbo_frame_tag "community-library" do %>

      <div class="flex items-baseline justify-between mb-5">
        <div>
          <h2 class="text-xl font-bold text-white">Community Library</h2>
          <% album_total = (@albums.total_count rescue @albums.count) %>
          <p class="text-xs text-zinc-500 mt-0.5">
            <%= @active_genres.any? ? "#{album_total} matching #{'album'.pluralize(album_total)}" : "#{album_total} albums logged on Noted" %>
          </p>
        </div>
      </div>

      <%# ── Genre filter pills (stackable / removable) ── %>
      <% if @genres.any? %>
        <div class="flex flex-wrap items-center gap-2 mb-6">
          <% @genres.each do |g| %>
            <% selected = @active_genres.include?(g) %>
            <%# Toggle: selected pill links to the set minus itself; unselected links to the set plus itself %>
            <% target = selected ? (@active_genres - [g]) : (@active_genres + [g]) %>
            <%= link_to albums_path(genres: target),
                  data: { turbo_action: "advance" },
                  class: "inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-semibold transition-colors #{selected ? 'bg-sp-green text-black' : 'bg-sp-surface text-zinc-300 hover:bg-sp-raised hover:text-white'}" do %>
              <%= g %>
              <% if selected %>
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
              <% end %>
            <% end %>
          <% end %>

          <% if @active_genres.any? %>
            <%= link_to "Clear all", albums_path, data: { turbo_action: "advance" },
                  class: "text-xs font-semibold text-zinc-500 hover:text-white transition-colors ml-1 underline underline-offset-2" %>
          <% end %>
        </div>
      <% end %>

      <% if @albums.any? %>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-5">
          <% @albums.each do |album| %>
            <%# turbo_frame: "_top" so the card navigates the whole page, not within the filter frame %>
            <%= link_to album_path(album), data: { turbo_frame: "_top" },
                  class: "group bg-sp-surface hover:bg-sp-raised rounded-lg p-4 transition-all cursor-pointer block" do %>
              <div class="aspect-square rounded-md mb-4 shadow-md group-hover:shadow-lg transition-shadow overflow-hidden">
                <% if album.cover_url(size: 300).present? %>
                  <img src="<%= album.cover_url(size: 300) %>"
                       alt="<%= album.title %>"
                       class="w-full h-full object-cover" />
                <% else %>
                  <div class="w-full h-full bg-gradient-to-br <%= album_gradient(album) %> to-zinc-900 flex items-center justify-center">
                    <svg class="w-14 h-14 text-white/20" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/>
                    </svg>
                  </div>
                <% end %>
              </div>
              <p class="font-semibold text-sm text-white truncate"><%= album.title %></p>
              <p class="text-xs text-zinc-400 truncate mt-0.5">
                <%= album.artist %>
                <% if album.genre.present? %>
                  <span class="text-zinc-700 mx-0.5">·</span>
                  <span class="text-zinc-500"><%= album.genre %></span>
                <% end %>
              </p>
              <div class="flex items-center gap-2 mt-2">
                <% if album.average_rating %>
                  <span class="text-xs font-bold <%= rating_color(album.average_rating) %>"><%= album.average_rating %>/10</span>
                  <span class="text-zinc-700 text-xs">·</span>
                <% end %>
                <span class="text-xs text-zinc-500"><%= album.log_count %> <%= album.log_count == 1 ? "log" : "logs" %></span>
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="mt-10 flex justify-center">
          <%= paginate @albums %>
        </div>
      <% elsif @active_genres.any? %>
        <div class="text-center py-16">
          <div class="text-5xl mb-4">🔍</div>
          <p class="text-lg font-bold mb-2">No albums in <%= @active_genres.to_sentence %></p>
          <p class="text-zinc-400 text-sm mb-4">Try a different genre or clear the filter.</p>
          <%= link_to "Clear filter", albums_path, data: { turbo_action: "advance" },
                class: "inline-block text-sm font-semibold text-sp-green hover:underline" %>
        </div>
      <% else %>
        <div class="text-center py-16">
          <div class="text-5xl mb-4">📀</div>
          <p class="text-lg font-bold mb-2">No albums yet</p>
          <p class="text-zinc-400 text-sm">Be the first to log one.</p>
        </div>
      <% end %>

    <% end %>
  </section>

</div>
