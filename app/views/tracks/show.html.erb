<% content_for :title, "#{@track.title} — Noted" %>

<%# ── Hero ── %>
<div class="relative">
  <div class="h-64 bg-gradient-to-b from-zinc-800 via-zinc-950/80 to-transparent px-8 pt-8 flex items-end pb-6">
    <div class="flex items-end gap-6">

      <%# Album art %>
      <% if @album.cover_url.present? %>
        <img src="<%= @album.cover_url %>"
             alt="<%= @album.title %>"
             class="w-40 h-40 rounded-lg shadow-2xl object-cover shrink-0" />
      <% else %>
        <div class="w-40 h-40 rounded-lg shadow-2xl bg-gradient-to-br <%= album_gradient(@album) %> to-zinc-900 shrink-0 flex items-center justify-center">
          <svg class="w-16 h-16 text-white/20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
          </svg>
        </div>
      <% end %>

      <div class="pb-1">
        <p class="text-xs uppercase tracking-widest text-zinc-400 mb-1">
          Track <%= @track.position %>
          <% if @track.duration_formatted %>
            <span class="text-zinc-600 mx-1">·</span>
            <%= @track.duration_formatted %>
          <% end %>
        </p>
        <h1 class="text-4xl font-extrabold text-white leading-tight"><%= @track.title %></h1>
        <div class="flex items-center gap-2 mt-2 text-sm flex-wrap">
          <%= link_to @album.artist, albums_path(q: @album.artist),
                class: "font-semibold text-white hover:underline" %>
          <span class="text-zinc-500">·</span>
          <%= link_to @album.title, album_path(@album),
                class: "text-zinc-300 hover:underline" %>
          <% if @album.release_year %>
            <span class="text-zinc-500">·</span>
            <span class="text-zinc-400"><%= @album.release_year %></span>
          <% end %>
          <% if @track_avg %>
            <span class="text-zinc-500">·</span>
            <span class="font-bold <%= rating_color(@track_avg) %>">
              <%= @track_avg %><span class="text-zinc-600 text-xs font-normal">/10 avg</span>
            </span>
          <% end %>
          <span class="text-zinc-500">·</span>
          <span class="text-zinc-400"><%= @track_log_count %> <%= @track_log_count == 1 ? "log" : "logs" %></span>
        </div>
      </div>

    </div>
  </div>
</div>

<div class="px-8 py-6 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">

  <%# ── Left: log panel ── %>
  <div class="space-y-6">

    <% if @user_log %>
      <%# ── Existing log ── %>
      <div class="bg-sp-surface rounded-xl p-6 border border-white/5">
        <div class="flex justify-between items-start mb-4">
          <p class="text-xs uppercase tracking-widest text-zinc-500">Your log</p>
          <div class="flex gap-2">
            <%= link_to "Edit", edit_track_log_path(@user_log),
                  class: "text-zinc-400 hover:text-white border border-zinc-700 hover:border-zinc-500 rounded-full px-3 py-1 transition-colors text-xs font-semibold" %>
            <%= button_to "Remove", track_log_path(@user_log), method: :delete,
                  class: "text-zinc-400 hover:text-red-400 border border-zinc-700 hover:border-red-900 rounded-full px-3 py-1 transition-colors text-xs font-semibold bg-transparent cursor-pointer" %>
          </div>
        </div>

        <% if @user_log.rating %>
          <span class="text-2xl font-extrabold <%= rating_color(@user_log.rating) %>">
            <%= @user_log.rating %><span class="text-zinc-600 text-base font-normal">/10</span>
          </span>
        <% else %>
          <p class="text-zinc-500 text-sm italic">No rating</p>
        <% end %>

        <% if @user_log.review.present? %>
          <p class="text-zinc-300 text-sm leading-relaxed mt-3"><%= @user_log.review %></p>
        <% end %>

        <p class="text-xs text-zinc-600 mt-3">
          Listened <%= @user_log.listened_on.strftime("%B %-d, %Y") %><%= " · relisten" if @user_log.is_relisten %>
        </p>
      </div>

    <% elsif user_signed_in? %>
      <%# ── Log form ── %>
      <div class="bg-sp-surface rounded-xl p-6 border border-white/5">
        <p class="text-xs uppercase tracking-widest text-zinc-500 mb-5">Log this track</p>

        <%= form_with url: track_logs_path, method: :post do %>
          <input type="hidden" name="track_log[track_id]" value="<%= @track.id %>" />

          <%# Rating (optional) %>
          <div class="mb-4">
            <label class="text-xs uppercase tracking-widest text-zinc-500 mb-2 block">
              Rating <span class="normal-case text-zinc-600">(optional)</span>
            </label>
            <div class="flex gap-1.5 flex-wrap">
              <% (1..10).each do |i| %>
                <label class="rating-option cursor-pointer">
                  <input type="radio" name="track_log[rating]" value="<%= i %>" class="sr-only" />
                  <span class="flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold text-zinc-400 hover:bg-white/10 transition-colors select-none"><%= i %></span>
                </label>
              <% end %>
            </div>
          </div>

          <%# Date + relisten %>
          <div class="flex items-end gap-3 mb-4">
            <div class="flex-1">
              <label class="text-xs uppercase tracking-widest text-zinc-500 mb-1 block">Date listened</label>
              <input name="track_log[listened_on]" type="date" required
                     value="<%= Date.today %>"
                     class="w-full bg-sp-muted rounded-md px-4 py-2.5 text-sm text-zinc-300 focus:outline-none focus:ring-1 focus:ring-white/30" />
            </div>
            <label class="flex items-center gap-2 text-sm text-zinc-400 cursor-pointer pb-2.5">
              <input type="checkbox" name="track_log[is_relisten]" value="1" class="accent-sp-green" />
              Relisten?
            </label>
          </div>

          <%# Review %>
          <textarea name="track_log[review]"
                    placeholder="Your thoughts… (optional)"
                    rows="3"
                    class="w-full bg-sp-muted rounded-md px-4 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-white/30 resize-none mb-5"></textarea>

          <button type="submit"
                  class="w-full bg-sp-green text-black font-bold py-3 rounded-full hover:bg-sp-green2 hover:scale-105 transition-all">
            Log it
          </button>
        <% end %>
      </div>

    <% else %>
      <div class="bg-sp-surface rounded-xl p-6 border border-white/5 text-center">
        <p class="text-zinc-400 text-sm mb-3">Sign in to log this track</p>
        <%= link_to "Sign in", new_user_session_path,
              class: "text-sm font-semibold text-sp-green hover:underline" %>
      </div>
    <% end %>

  </div>

  <%# ── Right: full tracklist with current track highlighted ── %>
  <div>
    <div class="flex items-center justify-between mb-3">
      <p class="text-xs uppercase tracking-widest text-zinc-500">Tracklist</p>
      <span class="text-xs text-zinc-600"><%= @album_tracks.size %> songs</span>
    </div>

    <div class="bg-sp-surface rounded-xl overflow-hidden">
      <% @album_tracks.each do |t| %>
        <% is_current = t.id == @track.id %>
        <%= link_to track_path(t),
              class: "flex items-center gap-3 px-4 py-2.5 border-b border-white/5 last:border-0 transition-colors #{is_current ? 'bg-sp-raised' : 'hover:bg-sp-card'}" do %>
          <span class="text-xs w-5 text-right shrink-0 <%= is_current ? 'text-sp-green' : 'text-zinc-600' %>">
            <%= t.position %>
          </span>
          <span class="flex-1 text-xs truncate <%= is_current ? 'text-white font-semibold' : 'text-zinc-300' %>">
            <%= t.title %>
          </span>
          <% if (avg = @track_ratings[t.id]) %>
            <span class="text-[11px] font-bold tabular-nums shrink-0 <%= rating_color(avg) %>">
              <%= avg %>
            </span>
          <% end %>
          <% if (dur = t.duration_formatted) %>
            <span class="text-xs shrink-0 <%= is_current ? 'text-zinc-400' : 'text-zinc-600' %>">
              <%= dur %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

</div>
