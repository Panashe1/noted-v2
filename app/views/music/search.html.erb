<%# Rendered without layout — injected into the modal search results area %>

<% if @results.empty? %>
  <p class="text-zinc-500 text-sm text-center py-4">No albums found. Try a different search.</p>
<% else %>
  <% @results.each do |album| %>
    <button type="button"
            data-action="click->log-flow#selectAlbum"
            data-itunes-id="<%= album[:itunes_id] %>"
            class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-white/5 transition-colors text-left group">
      <% if album[:cover_url].present? %>
        <img src="<%= album[:cover_url].gsub('600x600bb', '60x60bb') %>"
             alt="<%= album[:title] %>"
             class="w-12 h-12 rounded-md object-cover shrink-0 shadow-md" />
      <% else %>
        <div class="w-12 h-12 rounded-md bg-sp-muted shrink-0 flex items-center justify-center">
          <svg class="w-6 h-6 text-zinc-600" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/>
          </svg>
        </div>
      <% end %>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-white truncate"><%= album[:title] %></p>
        <p class="text-xs text-zinc-400 truncate">
          <%= album[:artist] %>
          <% if album[:release_year] %>
            <span class="text-zinc-600">·</span> <%= album[:release_year] %>
          <% end %>
          <% if album[:track_count]&.positive? %>
            <span class="text-zinc-600">·</span> <%= album[:track_count] %> tracks
          <% end %>
        </p>
      </div>
      <svg class="w-4 h-4 text-zinc-600 group-hover:text-white shrink-0 transition-colors" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
      </svg>
    </button>
  <% end %>
<% end %>
