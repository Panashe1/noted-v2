<% content_for :title, "Discover — Noted" %>

<div class="h-44 sm:h-56 bg-gradient-to-b from-green-900 via-zinc-950/80 to-zinc-950 px-4 sm:px-8 pt-8 sm:pt-10 flex flex-col justify-end pb-5 sm:pb-6">
  <p class="text-xs uppercase tracking-widest text-zinc-400 mb-1">AI-powered</p>
  <h1 class="text-4xl font-extrabold text-white">Discover</h1>
  <p class="text-zinc-400 text-sm mt-1">Ask Claude for music based on your taste</p>
</div>

<div class="px-4 sm:px-8 py-6 sm:py-8">

  <%# ── Search bar ── %>
  <%= form_with url: recommendations_path, method: :get do |f| %>
    <div class="flex gap-2 sm:gap-3 max-w-2xl">
      <div class="flex-1 relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500 pointer-events-none" viewBox="0 0 24 24" fill="currentColor">
          <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        </svg>
        <%= f.text_field :q,
              value: @query,
              placeholder: "e.g. cinematic post-rock with big dynamics…",
              autofocus: !@query.present?,
              class: "w-full bg-sp-muted text-white rounded-full pl-11 pr-4 py-3 text-sm placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20 transition" %>
      </div>
      <button type="submit"
              class="bg-sp-green text-black font-bold text-sm px-6 py-3 rounded-full hover:bg-sp-green2 hover:scale-105 transition-all shrink-0">
        Ask Claude
      </button>
    </div>
  <% end %>

  <%# ── Results ── %>
  <% if @recommendations.any? %>
    <div class="mt-8 max-w-2xl">
      <p class="text-xs uppercase tracking-widest text-zinc-500 mb-4">
        Results for "<%= @query %>"
      </p>

      <div class="space-y-2">
        <% @recommendations.each do |rec| %>
          <% dest = rec["itunes_id"].present? ? from_itunes_albums_path(itunes_id: rec["itunes_id"]) : nil %>
          <% tag_opts = dest ? { href: dest, class: "block group" } : { class: "block" } %>

          <%= content_tag(dest ? :a : :div, **tag_opts) do %>
            <div class="flex items-center gap-4 bg-sp-surface <%= dest ? 'hover:bg-sp-raised cursor-pointer' : '' %> rounded-xl p-4 transition-colors">

              <%# Album cover or gradient fallback %>
              <div class="w-16 h-16 rounded-lg shrink-0 overflow-hidden shadow-md">
                <% if rec["cover_url"].present? %>
                  <img src="<%= rec['cover_url'].gsub('600x600bb', '160x160bb') %>"
                       alt="<%= rec['title'] %>"
                       class="w-full h-full object-cover" />
                <% else %>
                  <div class="w-full h-full bg-gradient-to-br from-zinc-700 to-zinc-900 flex items-center justify-center">
                    <svg class="w-7 h-7 text-white/30" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/>
                    </svg>
                  </div>
                <% end %>
              </div>

              <%# Info ── %>
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline gap-2 flex-wrap">
                  <span class="font-semibold text-white text-sm truncate"><%= rec["title"] %></span>
                  <span class="text-zinc-500 text-xs shrink-0">by</span>
                  <span class="text-zinc-300 text-sm truncate"><%= rec["artist"] %></span>
                  <% if rec["year"].present? %>
                    <span class="text-zinc-600 text-xs shrink-0"><%= rec["year"] %></span>
                  <% end %>
                </div>
                <p class="text-zinc-400 text-xs leading-relaxed mt-1 line-clamp-2"><%= rec["description"] %></p>
              </div>

              <%# Arrow indicator when clickable %>
              <% if dest %>
                <svg class="w-4 h-4 text-zinc-600 group-hover:text-white shrink-0 transition-colors" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                </svg>
              <% end %>

            </div>
          <% end %>
        <% end %>
      </div>
    </div>

  <% elsif @query.present? %>
    <div class="mt-10 text-center py-12">
      <p class="text-zinc-500 text-sm">Claude couldn't respond right now. Try again.</p>
    </div>

  <% else %>
    <%# Prompt suggestions when idle %>
    <div class="mt-10 max-w-2xl">
      <p class="text-xs uppercase tracking-widest text-zinc-500 mb-4">Try asking…</p>
      <div class="flex flex-wrap gap-2">
        <% [
          "something like Radiohead but more rhythmic",
          "jazz for late night focus",
          "heavy albums with emotional depth",
          "90s R&B classics I might have missed",
          "ambient music for studying",
          "guitar-driven albums under 40 minutes"
        ].each do |suggestion| %>
          <%= link_to recommendations_path(q: suggestion),
                class: "bg-sp-muted hover:bg-sp-raised text-zinc-300 hover:text-white text-sm px-4 py-2 rounded-full transition-colors border border-zinc-800 hover:border-zinc-600" do %>
            <%= suggestion %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
