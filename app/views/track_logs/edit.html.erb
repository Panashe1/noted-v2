<% content_for :title, t("log_edit.track_title", track: @track.title) %>

<div class="h-36 sm:h-40 bg-gradient-to-b from-zinc-800 to-zinc-950 px-4 sm:px-8 pt-6 sm:pt-8 flex flex-col justify-end pb-4">
  <p class="text-xs uppercase tracking-widest text-zinc-500 mb-1"><%= t("log_edit.editing_track_log") %></p>
  <h1 class="text-2xl font-bold truncate"><%= @track.album.artist %> — <%= @track.title %></h1>
  <p class="text-sm text-zinc-400 mt-0.5"><%= @track.album.title %></p>
</div>

<div class="px-4 sm:px-8 py-6 sm:py-8 max-w-lg">
  <%= form_with model: @track_log, class: "space-y-5" do |f| %>

    <%# Rating (optional) %>
    <div>
      <label class="block text-xs uppercase tracking-widest text-zinc-500 mb-3">
        <%= t("log_edit.rating") %> <span class="normal-case text-zinc-600"><%= t("log_edit.rating_optional") %></span>
      </label>
      <div class="flex gap-1.5">
        <% (1..10).each do |i| %>
          <label class="rating-option cursor-pointer">
            <%= f.radio_button :rating, i, class: "sr-only" %>
            <span class="flex items-center justify-center w-9 h-9 rounded-full text-sm font-bold text-zinc-400 hover:bg-white/10 transition-colors select-none <%= @track_log.rating == i ? 'bg-sp-green !text-black' : '' %>">
              <%= i %>
            </span>
          </label>
        <% end %>
        <%# Clear rating option %>
        <label class="cursor-pointer flex items-center ml-1">
          <%= f.radio_button :rating, "", class: "sr-only" %>
          <span class="text-xs text-zinc-500 hover:text-white transition-colors"><%= t("log_edit.clear") %></span>
        </label>
      </div>
    </div>

    <div>
      <%= f.label :listened_on, t("log_edit.date_listened"), class: "block text-xs uppercase tracking-widest text-zinc-500 mb-2" %>
      <%= f.date_field :listened_on, required: true, max: Date.today,
            class: "w-full bg-sp-muted rounded-lg px-4 py-3 text-sm text-zinc-300 focus:outline-none focus:ring-1 focus:ring-white/30 transition" %>
    </div>

    <div>
      <%= f.label :review, t("log_edit.review"), class: "block text-xs uppercase tracking-widest text-zinc-500 mb-2" %>
      <%= f.text_area :review, rows: 5,
            placeholder: t("log_edit.review_placeholder_optional"),
            class: "w-full bg-sp-muted rounded-lg px-4 py-3 text-sm placeholder-zinc-600 focus:outline-none focus:ring-1 focus:ring-white/30 transition resize-none" %>
    </div>

    <div class="flex items-center gap-3">
      <%= f.check_box :is_relisten, class: "w-4 h-4 rounded accent-sp-green cursor-pointer" %>
      <%= f.label :is_relisten, t("log_edit.is_relisten"), class: "text-sm text-zinc-400 cursor-pointer" %>
    </div>

    <div class="flex items-center gap-4 pt-2">
      <%= f.submit t("actions.save_changes"),
            class: "bg-white text-black font-bold text-sm px-6 py-3 rounded-full hover:scale-105 transition-transform cursor-pointer" %>
      <%= link_to t("actions.cancel"), track_path(@track),
            class: "text-zinc-400 hover:text-white text-sm transition-colors" %>
    </div>

  <% end %>
</div>
