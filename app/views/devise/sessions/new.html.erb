<% content_for :title, "Log in — Noted" %>

<div class="min-h-screen flex items-center justify-center py-16 px-4">
  <div class="w-full max-w-sm">
    <div class="text-center mb-10">
      <p class="wordmark font-bold text-4xl text-white mb-3">noted</p>
      <p class="text-zinc-400 text-sm">Log in to continue</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            placeholder: "Email address",
            class: "w-full bg-sp-muted rounded-md px-4 py-3 text-sm placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20 transition" %>

      <%= f.password_field :password, autocomplete: "current-password",
            placeholder: "Password",
            class: "w-full bg-sp-muted rounded-md px-4 py-3 text-sm placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20 transition" %>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-zinc-400 cursor-pointer">
          <%= f.check_box :remember_me, class: "accent-sp-green" %>
          Remember me
        </label>
      <% end %>

      <%= f.submit "Log in",
            class: "w-full bg-sp-green text-black font-bold py-3 rounded-full hover:bg-sp-green2 hover:scale-[1.02] transition-all cursor-pointer mt-2" %>
    <% end %>

    <div class="mt-8 text-center text-sm text-zinc-500">
      Don't have an account?
      <%= link_to "Sign up for Noted", new_user_registration_path, class: "text-white font-semibold hover:underline" %>
    </div>

    <div class="mt-3 text-center text-sm">
      <%= link_to "Forgot your password?", new_user_password_path, class: "text-zinc-500 hover:text-white transition-colors" %>
    </div>
  </div>
</div>
